rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    // Helpers
    // ============================
    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasPermission(permission) {
      return getCurrentUser().data.permissions.hasAny([permission]);
    }

    function userOwnsDocument() {
      return request.auth.uid == resource.data.userId;
    }

    // Para updates de users: saber si se está modificando "permissions"
    function isChangingPermissions() {
      return request.resource.data.permissions != resource.data.permissions;
    }

    // ============================
    // COLECCIÓN: users
    // ============================
    match /users/{userId} {
      function isSelf() {
        return request.auth.uid == userId;
      }

      // Leer user:
      // - el propio usuario
      // - admins que pueden listar usuarios
      // - admins que pueden listar permisos de usuario
      allow read: if request.auth != null && (
        isSelf() ||
        hasPermission('admin.user.list') ||
        hasPermission('admin.user.permissions.list')
      );

      // Crear su propio documento
      allow create: if request.auth != null && isSelf();

      // Actualizar:
      // - Usuario normal: puede editarse a sí mismo pero NO cambiar permissions
      // - Admin con admin.user.edit: puede editar cualquier user (sin cambiar permissions)
      // - Cambiar el campo permissions SOLO si tiene permisos para gestionarlos
      allow update: if request.auth != null && (
        // Usuario editando su propio perfil (sin tocar permissions)
        (isSelf() && !isChangingPermissions()) ||

        // Admin editando datos de usuario (sin tocar permissions)
        (hasPermission('admin.user.edit') && !isChangingPermissions()) ||

        // Cambios en permissions: requiere permisos especiales
        (isChangingPermissions() && (
          hasPermission('admin.user.permissions.add') ||
          hasPermission('admin.user.permissions.delete')
        ))
      );

      // Eliminar usuario: solo admin con permiso explícito
      allow delete: if request.auth != null && hasPermission('admin.user.delete');
    }

    // ============================
    // COLECCIÓN: applications
    // ============================
    match /applications/{applicationId} {
      function isLoggedIn() {
        return request.auth != null;
      }

      // Leer aplicaciones
      // - permiso applications.view (lo que ya usas en React)
      // - opcional: otros permisos admin si quisieras ampliar
      allow read: if isLoggedIn() && hasPermission('applications.view');

      // Crear / actualizar / borrar aplicaciones: applications.sync
      allow write: if isLoggedIn() && hasPermission('applications.sync');

      // ============================
      // SUB-COLECCIÓN: applications/{applicationId}/votes
      // ============================
      match /votes/{voteId} {
        function isOwnerExisting() {
          // resource solo existe en update/delete
          return request.auth.uid == resource.data.userId;
        }

        function isOwnerNew() {
          // para create se usa request.resource
          return request.auth.uid == request.resource.data.userId;
        }

        // Leer votos:
        // - permiso applications.vote.view (tu canViewVoteDetails)
        // - permiso admin.user.vote.list (tu canListUserVotes)
        allow read: if isLoggedIn() && (
          hasPermission('applications.vote.view') ||
          hasPermission('admin.user.vote.list')
        );

        // Crear voto:
        // - permiso applications.vote.create (tu canVote)
        // - solo el propio usuario
        allow create: if isLoggedIn() &&
          hasPermission('applications.vote.create') &&
          isOwnerNew();

        // Actualizar voto:
        // - permiso applications.vote.create
        // - solo el propietario
        // - userId no se puede cambiar
        allow update: if isLoggedIn() &&
          hasPermission('applications.vote.create') &&
          isOwnerExisting() &&
          isOwnerNew();

        // Eliminar voto:
        // - dueño del voto
        // - o admin con admin.user.vote.delete
        allow delete: if isLoggedIn() && (
          isOwnerExisting() ||
          hasPermission('admin.user.vote.delete')
        );
      }
    }

    // ============================
    // RUTA DE RESPALDO (Deny All)
    // ============================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}